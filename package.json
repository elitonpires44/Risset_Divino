{
  "name": "projeto-milenio-risset-divino",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare.mjs && next build",
    "check": "node --check src/render.js && node --check src/content/site.js && node --check src/scripts/sound.js && node --check scripts/build.mjs && node --test tests/*.test.mjs",
    "dev": "node scripts/prepare.mjs && next dev --hostname 0.0.0.0",
    "build:static": "node scripts/build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "playwright": "1.58.2"
  }
}
